<script>
window.addEventListener('scroll',()=>{
  const el=document.documentElement;
  document.getElementById('pb').style.width=(el.scrollTop/(el.scrollHeight-el.clientHeight)*100)+'%';
});
const answered={};
function answer(qid,chosen,correct){
  if(answered[qid])return;
  answered[qid]=true;
  const opts=document.querySelectorAll('#'+qid+' .q-opt');
  const letters=['A','B','C','D'];
  opts.forEach((o,i)=>{
    o.classList.add('disabled');
    if(letters[i]===correct)o.classList.add('correct');
    else if(letters[i]===chosen&&chosen!==correct)o.classList.add('wrong');
  });
  if(chosen===correct){
    const fb=document.getElementById(qid+'-fb-correct');
    if(fb)fb.classList.add('show');
  }else{
    const fb=document.getElementById(qid+'-fb-wrong');
    if(fb)fb.classList.add('show');
  }
}
const io=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('vs')});
},{threshold:.08});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
</script>
